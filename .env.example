# Copiá este archivo como .env y completá los valores
# Token del bot de Discord (distinto al del BOT DDO)
DISCORD_TOKEN=pega_aca_el_token_del_bot

# Clave de la API de Riot (developer.riotgames.com). La de desarrollo vence cada 24 h
RIOT_API_KEY=RGAPI-pega-aca-tu-clave

# Canal de texto para el resumen (vacío = el chat del canal de voz donde están)
CANAL_TEXTO_ID=

# Lo que dice por voz: en derrotas anuncia al peor y en victorias al mejor.
# {jugador} = "Invocador con Campeón" si está vinculado, o "el jugador de Campeón" si no
# {jugador_enfasis} = lo mismo con el nombre entre "¡!" ("¡Invocador! con Campeón"), la voz lo enfatiza
# (a los no vinculados nunca se los nombra). Otras variables: {campeon} {kills} {muertes}
# {asistencias} {kda} {puntaje}
MENSAJE_PEOR=El peor del equipo fue {jugador}: {kills} kills, {muertes} muertes y {asistencias} asistencias
MENSAJE_MEJOR=El mejor del equipo fue {jugador}: {kills} kills, {muertes} muertes y {asistencias} asistencias

# Voz (edge-tts). Ej: es-AR-TomasNeural, es-AR-ElenaNeural
VOZ=es-AR-TomasNeural
VELOCIDAD=+0%
TONO=+0Hz

# Cada cuántos segundos revisa si terminó una partida
INTERVALO_SEGUNDOS=90
# Partidas que terminaron hace más de estos minutos no se anuncian
MAX_ANTIGUEDAD_MIN=20

# Rol para el peor vinculado de la última derrota: lo conserva hasta que otro vinculado salga peor.
# Vacío = sin rol. El bot lo crea si no existe (necesita el permiso Gestionar roles).
ROL_PEOR=El más manco

# Motor de voz: edge (edge-tts, en la nube) o xtts (XTTS-v2 en la PC, clonando una voz).
# Con xtts, cada frase nueva tarda unos 30 s en generarse (carga el modelo, genera y lo libera);
# si falla o tarda más de XTTS_TIMEOUT_SEGUNDOS, ese anuncio sale con edge-tts.
VOZ_MOTOR=edge
# Rutas relativas a esta carpeta (o absolutas)
XTTS_PYTHON=
XTTS_REFERENCIA=
XTTS_TEMPERATURA=0.75
XTTS_TIMEOUT_SEGUNDOS=180
